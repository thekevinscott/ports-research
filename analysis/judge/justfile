test-unit:
    uv run pytest src -x -q

test-integration:
    uv run pytest tests/integration -x -q

# The dry run: real claude calls over the baseline pair and the given run directories.
test-e2e out +runs:
    JUDGE_OUT={{out}} JUDGE_RUNS="{{runs}}" uv run pytest tests/e2e -rA

lint:
    uv run ruff check src tests
