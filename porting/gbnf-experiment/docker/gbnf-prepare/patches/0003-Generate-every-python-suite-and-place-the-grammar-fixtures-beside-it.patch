From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gbnf-prepare <gbnf-prepare@localhost>
Date: Sun, 27 Sep 2026 11:36:35 +0000
Subject: [PATCH] Generate every python suite and place the grammar fixtures
 beside it

---
 packages/gbnf/python/Makefile | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/packages/gbnf/python/Makefile b/packages/gbnf/python/Makefile
index 6210a46..f33897b 100644
--- a/packages/gbnf/python/Makefile
+++ b/packages/gbnf/python/Makefile
@@ -25,11 +25,10 @@ write_integration_tests:
 	@echo "Writing integration tests..."
 	@$(MAKE) -s build_test_writer
 	@node --no-warnings ../../test-writer/dist/test-writer.mjs \
-		validation \
-		iteration/iteration \
 		--testDir ../test \
 		--targetDir ./tests/generated \
 		--language python
+	@cp -r ../test/iteration/grammars ./tests/generated/iteration/grammars
 
 test_integration:
 	@$(MAKE) -s write_integration_tests
