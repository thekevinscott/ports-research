 packages/test-writer/src/format-python.ts        | 11 ++++-------
 .../hydrate-variables.test.ts                    | 14 +++++++++++++-
 .../hydrate-variables.ts                         | 16 +++-------------
 3 files changed, 20 insertions(+), 21 deletions(-)

