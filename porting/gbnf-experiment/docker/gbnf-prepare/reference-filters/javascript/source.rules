# rsync rules for the typescript package, rooted at packages/gbnf/javascript.
# First match wins, so the exclusions lead. A whitelist: anything not named
# here never reaches the agent. Adding a file to the corpus means adding a line.

# Tests are withheld unless a flag prepends the rules that include them.
- *.test.ts
- /integration-tests/

# dev/ is browser and node demo apps, not the library.
- /dev/

# src/builder/ is a grammar-authoring DSL with no counterpart to port.
- /src/builder/

# pnpm install ran in this tree; its symlink farm is not corpus.
- node_modules/

+ */

+ /.eslintrc.cjs
+ /.gitignore
+ /.npmignore
+ /README.md
+ /package.json
+ /tsconfig.json
+ /tsconfig.test.json
+ /vite.config*.ts
+ /vitest.config*.ts
+ /src/**.ts

- *
