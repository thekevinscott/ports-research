{
  "name": "gbnf",
  "version": "0.0.30",
  "description": "A library for parsing GBNF grammars",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "gbnf",
    "grammar",
    "llama.cpp",
    "parser"
  ],
  "author": "Ambient Labs <maintainers@gbnf.dev>",
  "license": "MIT",
  "homepage": "https://github.com/ambient-labs/GBNF",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambient-labs/GBNF.git"
  },
  "bugs": {
    "url": "https://github.com/ambient-labs/GBNF/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.3"
  }
}
