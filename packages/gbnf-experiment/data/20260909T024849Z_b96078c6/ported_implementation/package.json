{
  "name": "gbnf",
  "version": "0.0.30",
  "description": "A library for parsing GBNF grammars",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./gbnf/*": "./gbnf/*",
    "./grammar_graph/*": "./gbnf/grammar_graph/*",
    "./rules_builder/*": "./gbnf/rules_builder/*",
    "./grammar_parser/*": "./gbnf/grammar_parser/*",
    "./dist/*": "./dist/*",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "gbnf",
    "dist",
    "index.ts",
    "index.js"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "test:watch": "node --test --watch \"test/*.test.ts\"",
    "build": "node scripts/build-js.mjs",
    "fixtures": "python3 scripts/generate_reference_fixture.py"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
