# rsync rules for the javascript package, rooted at packages/gbnf and anchored
# to /javascript so nothing here matches the other language's tree. First match
# wins, so the exclusions lead. A whitelist: anything not named here never
# reaches the agent. Adding a file to the corpus means adding a line. The
# traversal and the final catch-all exclusion are added once by
# assemble_whitelist.

# Tests are withheld unless a flag puts the rules that include them first.
- /javascript/**.test.ts
- /javascript/integration-tests/

# dev/ is browser and node demo apps, not the library.
- /javascript/dev/

# src/builder/ is a grammar-authoring DSL with no counterpart to port.
- /javascript/src/builder/

# pnpm install ran in this tree; its symlink farm is not corpus.
- /javascript/**/node_modules/

+ /javascript/.eslintrc.cjs
+ /javascript/.gitignore
+ /javascript/.npmignore
+ /javascript/README.md
+ /javascript/package.json
+ /javascript/tsconfig.json
+ /javascript/tsconfig.test.json
+ /javascript/vite.config*.ts
+ /javascript/vitest.config*.ts
+ /javascript/src/**.ts
